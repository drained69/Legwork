# ── Telegram (the user-facing surface) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=LegworkBot

# ── Service API & Telegraph miner surface ───────────────────────────────────
PORT=8402
# Public base URL of this deployment (Railway/Fly URL). Telegraph nodes fetch
# the miner YAML from PUBLIC_URL/miner.yaml, so it must be set in production.
PUBLIC_URL=

# ── Per-call payments (Base Sepolia, direct ERC-20 transfer) ────────────────
PAYMENT_NETWORK=base-sepolia
PAYMENT_CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# ERC-20 accepted for payment (testnet USDC).
PAYMENT_ASSET_ADDRESS=
PAYMENT_ASSET_SYMBOL=USDC
PAYMENT_ASSET_DECIMALS=6
# Wallet address payments settle to.
PAYMENT_PAY_TO=
PAYMENT_CONFIRMATIONS=1
# AES key encrypting per-user wallet keys in the database.
WALLET_ENCRYPTION_KEY=

# ── Job sources ─────────────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com

# ── LLM (scoring + tailoring). Falls back to deterministic heuristics. ─────
# Google Gemini is checked FIRST when any of these keys is set. Free API keys
# from https://aistudio.google.com/apikey — the free tier allows 15 requests/
# minute PER KEY, and validators probe this miner in bursts: one key means
# burst 429s that degrade answers mid-epoch. The pool rotates on 429 within
# the same request; each key adds 15 RPM of burst headroom.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Defaults to gemini-3.5-flash-lite, chosen by latency measurement — see
# src/config.ts before changing.
GEMINI_MODEL=gemini-3.5-flash-lite
# Anthropic-compatible fallback (used only when no Gemini key is set). Any
# gateway works via ANTHROPIC_BASE_URL (e.g. https://agentrouter.org).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Gmail (apply-executor sends from the user's real address) ──────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Redflag: buying answers from other Telegraph miners (x402) ───────────────
# Engine base URL of the node Redflag queries (default is the live testnet node).
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
# Wallet that pays miner calls. Fund with Base Sepolia USDC
# (0x036CbD53842c5426634e7929541eC2318f3dCF7e). x402 signatures are gasless.
# Without it, Redflag runs degraded (local checks only) and reports that.
TELEGRAPH_PRIVATE_KEY=
# Per-report ceiling on miner spend; checks over the remaining budget are
# skipped before payment.
REDFLAG_MAX_SPEND_USD=0.08
# Identical queries reuse the cached signal instead of paying again (seconds).
TELEGRAPH_CACHE_TTL_SEC=300
# Standing watches: re-check each company's news every N hours.
REDFLAG_WATCH_INTERVAL_HOURS=6
# Most one watch news-check may cost.
REDFLAG_WATCH_CHECK_BUDGET_USD=0.02
# Most ALL watches may cost in one poller sweep together.
REDFLAG_WATCH_TICK_BUDGET_USD=0.20
# How often the watch poller wakes to look for due watches (minutes).
REDFLAG_WATCH_POLL_MINUTES=15
# ── The public web app (/redflag) ────────────────────────────────────────────
# "Run full vetting" is operator-paid: Legwork's wallet buys the miner checks.
# Guardrails: per-IP rate limit and a daily spend ceiling read from the
# reports ledger (survives restarts). Over either → honest refusal, free scan
# still works.
REDFLAG_WEB_FULL_RATE_PER_HOUR=2
REDFLAG_WEB_DAILY_BUDGET_USD=3.00

# ── Storage ─────────────────────────────────────────────────────────────────
DATABASE_PATH=legwork.db
# Durable working directory — point it at the same persistent volume as the
# database in production (the Dockerfile sets /data).
DATA_DIR=.
# Set true ONLY when a proxy you control (Railway, Fly, a load balancer)
# terminates connections in front of this process. It makes the free-tier rate
# limiter read the last X-Forwarded-For hop instead of the socket peer; if the
# process is directly exposed, any caller could forge that header.
TRUST_PROXY=false
