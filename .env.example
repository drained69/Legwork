# ── Telegram (the only user-facing surface) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=LegworkBot

# ── OKX AI marketplace ────────────────────────────────────────────────────
OKX_AGENT_ID=
OKX_WALLET_PRIVATE_KEY=
OKX_ENDPOINT_PORT=8402
OKX_INBOUND_SECRET=
# Public base URL of this deployment (Railway/Fly URL) — used in x402 challenges.
PUBLIC_URL=

# ── Marketplace polling (REQUIRED — without it, tasks expire unclaimed) ────
# Numeric ERC-8004 agent id of the ASP identity (`onchainos agent my-agents`).
# The poller pulls tasks routed to this id and claims them. Unset = no polling.
OKX_ASP_AGENT_ID=
# onchainos home holding the SERVICE's wallet session. Must be a session that
# is signed in as the ASP identity above — keep it separate from the per-user
# wallet homes under WALLET_HOME_ROOT.
OKX_ONCHAINOS_HOME=
# Poll cadence (ms). Tasks expire on the backend's clock — don't raise this
# much above a minute.
OKX_POLL_INTERVAL_MS=30000
# Apply on-chain to tasks that already designate this agent as provider.
OKX_AUTO_APPLY=true
# Never auto-apply above this budget; a bigger task gets a human look first.
OKX_MAX_AUTO_APPLY_BUDGET=10
# Run the hunt and submit the deliverable automatically once escrow is funded.
OKX_AUTO_DELIVER=true
# Log what the poller WOULD claim without acting (verification only).
OKX_POLL_DRY_RUN=false
OKX_CHAIN_INDEX=196

# ── x402 per-call payments (OKX Agent Payments Protocol, seller side) ─────
# Chain payments are accepted on (CAIP-2). X Layer mainnet = eip155:196.
X402_NETWORK=eip155:196
# ERC-20 accepted for payment — set the REAL USDC/USDT contract before listing.
X402_ASSET_ADDRESS=
X402_ASSET_SYMBOL=USDC
X402_ASSET_DECIMALS=6
# Agent wallet address payments settle to.
X402_PAY_TO=
# x402 facilitator (signature verification + on-chain settlement).
X402_FACILITATOR_URL=
# Dev/test ONLY — accept structurally-valid payments without settlement.
X402_DEV_ACCEPT_UNVERIFIED=false

# ── Job sources ───────────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com

# ── LLM (scoring + tailoring). Falls back to deterministic heuristics. ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Gmail (apply-executor sends from the user's real address) ────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────
DATABASE_PATH=legwork.db
# Durable working directory. Delivered payloads are written to
# $DATA_DIR/deliverables as dispute evidence, so point this at the same
# persistent volume as the database in production (the Dockerfile sets /data).
DATA_DIR=.
# Set true ONLY when a proxy you control (Railway, Fly, a load balancer)
# terminates connections in front of this process. It makes the free-tier rate
# limiter read the last X-Forwarded-For hop instead of the socket peer; if the
# process is directly exposed, any caller could forge that header.
TRUST_PROXY=false
# Default AI provider bound for the okx-a2a runtime (codex|claude|hermes|openclaw).
# The A2A doctor treats an unbound provider as a blocking failure, which makes
# gate-check report communication as not ready and starts the poller degraded.
# Nothing here dispatches to a local AI CLI — this only satisfies that gate.
OKX_A2A_PROVIDER=claude
# Where the okx-a2a daemon keeps XMTP identity keys, per-job sessions and the
# buyer chat history. MUST be on durable storage: the buyer's criteria arrive
# over XMTP and live only here, and a fresh XMTP installation is minted every
# time this is lost. The Dockerfile points it at the mounted volume.
OKX_AGENT_TASK_HOME=
