# ── Telegram (the only user-facing surface) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=LegworkBot

# ── OKX AI marketplace ────────────────────────────────────────────────────
OKX_AGENT_ID=
OKX_WALLET_PRIVATE_KEY=
OKX_ENDPOINT_PORT=8402
OKX_INBOUND_SECRET=
# Public base URL of this deployment (Railway/Fly URL) — used in x402 challenges.
PUBLIC_URL=

# ── x402 per-call payments (OKX Agent Payments Protocol, seller side) ─────
# Chain payments are accepted on (CAIP-2). X Layer mainnet = eip155:196.
X402_NETWORK=eip155:196
# ERC-20 accepted for payment — set the REAL USDC/USDT contract before listing.
X402_ASSET_ADDRESS=
X402_ASSET_SYMBOL=USDC
X402_ASSET_DECIMALS=6
# Agent wallet address payments settle to.
X402_PAY_TO=
# x402 facilitator (signature verification + on-chain settlement).
X402_FACILITATOR_URL=
# Dev/test ONLY — accept structurally-valid payments without settlement.
X402_DEV_ACCEPT_UNVERIFIED=false

# ── Job sources ───────────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com

# ── LLM (scoring + tailoring). Falls back to deterministic heuristics. ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Gmail (apply-executor sends from the user's real address) ────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────
DATABASE_PATH=legwork.db
