# ── Telegram (the only user-facing surface) ──────────────────────────────
# From @BotFather. If unset, the bot does not start (demo mode still works).
TELEGRAM_BOT_TOKEN=

# ── OKX AI marketplace (every engagement flows through here) ─────────────
# Assigned after ERC-8004 agent registration on the OKX agent registry.
OKX_AGENT_ID=
# Dedicated agent wallet (never a personal wallet). Used to sign/settle.
OKX_WALLET_PRIVATE_KEY=
# Port for the inbound A2A service endpoint OKX calls.
OKX_ENDPOINT_PORT=8402
# Shared secret / header check for inbound OKX envelopes (until signature
# verification is wired to the registry).
OKX_INBOUND_SECRET=

# ── Job sources ───────────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com

# ── LLM (scoring + tailoring). Falls back to deterministic heuristics. ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Gmail (apply-executor sends from the user's real address) ────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────
DATABASE_PATH=legwork.db

# ── Bot public username (for OKX deep links t.me/<username>?start=code) ──
TELEGRAM_BOT_USERNAME=LegworkBot
